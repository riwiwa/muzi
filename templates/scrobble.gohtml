{{define "scrobble"}}
  <header class="page-title">
    <div class="eyebrow">Manual scrobble</div>
    <h1>Log a listen</h1>
    <p>For plays that didn't get scrobbled — a record, a radio set, a friend's aux cord.</p>
  </header>

  <div id="message" class="message" style="display: none;"></div>

  <form id="scrobble-form" class="card">
    <div id="rows-container"></div>
    <div class="scrobble-actions">
      <button type="button" id="add-row">+ Add another</button>
      <button type="submit">Scrobble</button>
    </div>
  </form>

  <template id="scrobble-row-template">
    <div class="scrobble-row">
      <input type="text" name="song_name" placeholder="Song" required aria-label="Song">
      <input type="text" name="artist" placeholder="Artist" required aria-label="Artist">
      <input type="text" name="album_name" placeholder="Album (optional)" aria-label="Album">
      <input type="date" name="date" required aria-label="Date">
      <input type="time" name="time" required step="1" aria-label="Time">
      <input type="number" name="duration" placeholder="Seconds" min="0" aria-label="Duration in seconds">
      <button type="button" class="remove-row" aria-label="Remove row">&times;</button>
    </div>
  </template>

  <script>
    (function () {
      const container = document.getElementById('rows-container');
      const template = document.getElementById('scrobble-row-template');

      function pad(n) { return String(n).padStart(2, '0'); }

      function addRow() {
        const row = template.content.firstElementChild.cloneNode(true);
        const now = new Date();
        row.querySelector('[name="date"]').value = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
        row.querySelector('[name="time"]').value = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
        container.appendChild(row);
        updateRemoveButtons();
        row.querySelector('input').focus();
      }

      function updateRemoveButtons() {
        const single = container.children.length <= 1;
        container.querySelectorAll('.remove-row').forEach(function (btn) { btn.style.visibility = single ? 'hidden' : ''; });
      }

      function showMessage(text, type) {
        const msg = document.getElementById('message');
        msg.textContent = text;
        msg.className = 'message ' + type;
        msg.style.display = 'block';
      }

      document.getElementById('add-row').addEventListener('click', addRow);
      container.addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-row')) {
          e.target.closest('.scrobble-row').remove();
          updateRemoveButtons();
        }
      });

      document.getElementById('scrobble-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        const tracks = [];
        for (const row of container.querySelectorAll('.scrobble-row')) {
          const songName = row.querySelector('[name="song_name"]').value.trim();
          const artist = row.querySelector('[name="artist"]').value.trim();
          const date = row.querySelector('[name="date"]').value;
          const time = row.querySelector('[name="time"]').value;
          const duration = row.querySelector('[name="duration"]').value;
          if (!songName || !artist || !date || !time) continue;
          tracks.push({
            song_name: songName,
            artist: artist,
            album_name: row.querySelector('[name="album_name"]').value.trim(),
            timestamp: new Date(date + 'T' + time).toISOString(),
            ms_played: duration ? parseInt(duration, 10) * 1000 : 0
          });
        }
        if (tracks.length === 0) {
          showMessage('Fill in at least one complete row.', 'error');
          return;
        }
        try {
          const response = await fetch('/scrobble', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tracks: tracks })
          });
          const result = await response.json();
          if (response.ok) {
            showMessage('Scrobbled ' + result.count + ' track' + (result.count === 1 ? '' : 's') + '.', 'success');
            container.innerHTML = '';
            addRow();
          } else {
            showMessage(result.error || 'Failed to scrobble tracks.', 'error');
          }
        } catch (err) {
          showMessage('Something went wrong. Please try again.', 'error');
        }
      });

      addRow();
    })();
  </script>
{{end}}
