{{define "song"}}
  {{$owner := eq .LoggedInUsername .Username}}
  <section class="hero">
    {{if .ImageUrl}}<img class="hero-backdrop" src="{{.ImageUrl}}" alt="" aria-hidden="true">{{end}}
    {{template "hero-art" (dict "url" .ImageUrl "name" .Song.Title "vt" (artName "song" .Song.Id)
      "edit" $owner "entity" "song" "id" .Song.Id "field" "image_url")}}
    <div class="hero-text">
      <div class="eyebrow">Track</div>
      <h1>{{.Song.Title}}</h1>
      <div class="hero-sub">
        {{if .ArtistNames}}
        <span>by {{range $i, $name := .ArtistNames}}{{if $i}}, {{end}}<a href="/profile/{{$.Username}}/artist/{{urlquery $name}}">{{$name}}</a>{{end}}</span>
        {{end}}
        {{if .Albums}}
        <span>on {{range $i, $a := .Albums}}{{if $i}}, {{end}}<a href="/profile/{{$.Username}}/album/{{urlquery $.Artist.Name}}/{{urlquery $a.Title}}">{{$a.Title}}</a>{{end}}</span>
        {{end}}
      </div>
      <div class="stats">
        <div class="stat"><b>{{formatInt .ListenCount}}</b><span>Listens</span></div>
      </div>
      {{if $owner}}
      <div class="hero-actions">
        <button class="btn btn-small" type="button" onclick="openEditModal()">Edit</button>
      </div>
      {{end}}
    </div>
  </section>

  <section class="block" id="plays">
    <header class="block-head"><h2>Plays</h2>{{if $owner}}<button class="btn btn-small" type="button" data-select-toggle>Select</button>{{end}}</header>
    {{template "feed" (dict "entries" .Times "username" .Username "cover" .ImageUrl "select" $owner)}}
    <nav class="pager">
      {{if gt .Page 1}}<a class="btn btn-small" href="/profile/{{.Username}}/song/{{urlquery .Artist.Name}}/{{urlquery .Song.Title}}?page={{sub .Page 1}}#plays">← Newer</a>{{end}}
      {{if .Times}}<a class="btn btn-small" href="/profile/{{.Username}}/song/{{urlquery .Artist.Name}}/{{urlquery .Song.Title}}?page={{add .Page 1}}#plays">Older →</a>{{end}}
    </nav>
  </section>

  {{if $owner}}
  <div id="editModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <h2>Edit track</h2>
      <form id="editForm" data-entity="song" data-id="{{.Song.Id}}">
        <label>Title <input type="text" name="title" value="{{.Song.Title}}"></label>
        <label>Spotify ID <input type="text" name="spotify_id" value="{{.Song.SpotifyId}}"></label>
        <label>MusicBrainz ID <input type="text" name="musicbrainz_id" value="{{.Song.MusicbrainzId}}"></label>
        <p class="modal-hint">Click the artwork to upload your own image.</p>
        <div class="modal-buttons">
          <button type="button" class="reset-image-btn" onclick="resetImage('song', {{.Song.Id}}, 'image_url')">Use automatic image</button>
          <button type="button" onclick="closeEditModal()">Cancel</button>
          <button type="submit">Save</button>
        </div>
      </form>
    </div>
  </div>
  {{end}}
{{end}}
