{{define "artist"}}
  {{$owner := eq .LoggedInUsername .Username}}
  <section class="hero">
    {{if .Artist.ImageUrl}}<img class="hero-backdrop" src="{{.Artist.ImageUrl}}" alt="" aria-hidden="true">{{end}}
    {{template "hero-art" (dict "url" .Artist.ImageUrl "name" .Artist.Name "vt" (artName "artist" .Artist.Id) "round" true
      "edit" $owner "entity" "artist" "id" .Artist.Id "field" "image_url")}}
    <div class="hero-text">
      <div class="eyebrow">Artist</div>
      <h1>{{.Artist.Name}}</h1>
      <div class="stats">
        <div class="stat"><b>{{formatInt .ListenCount}}</b><span>Listens</span></div>
      </div>
      {{if $owner}}
      <div class="hero-actions">
        <button class="btn btn-small" type="button" onclick="openEditModal()">Edit</button>
      </div>
      {{end}}
    </div>
  </section>

  {{if .Artist.Bio}}
  <section class="block">
    <header class="block-head"><h2>About</h2></header>
    <p class="bio" id="bio-display">{{.Artist.Bio}}</p>
  </section>
  {{end}}

  <section class="block" id="plays">
    <header class="block-head"><h2>Plays</h2></header>
    {{template "feed" (dict "entries" .Times "username" .Username)}}
    <nav class="pager">
      {{if gt .Page 1}}<a class="btn btn-small" href="/profile/{{.Username}}/artist/{{urlquery .Artist.Name}}?page={{sub .Page 1}}#plays">← Newer</a>{{end}}
      {{if .Times}}<a class="btn btn-small" href="/profile/{{.Username}}/artist/{{urlquery .Artist.Name}}?page={{add .Page 1}}#plays">Older →</a>{{end}}
    </nav>
  </section>

  {{if $owner}}
  <div id="editModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <h2>Edit artist</h2>
      <form id="editForm" data-entity="artist" data-id="{{.Artist.Id}}">
        <label>Name <input type="text" name="name" value="{{.Artist.Name}}"></label>
        <label>Bio <textarea name="bio">{{.Artist.Bio}}</textarea></label>
        <label>Spotify ID <input type="text" name="spotify_id" value="{{.Artist.SpotifyId}}"></label>
        <label>MusicBrainz ID <input type="text" name="musicbrainz_id" value="{{.Artist.MusicbrainzId}}"></label>
        <p class="modal-hint">Click the artwork to upload your own image.</p>
        <div class="modal-buttons">
          <button type="button" class="reset-image-btn" onclick="resetImage('artist', {{.Artist.Id}}, 'image_url')">Use automatic image</button>
          <button type="button" onclick="closeEditModal()">Cancel</button>
          <button type="submit">Save</button>
        </div>
      </form>
    </div>
  </div>
  {{end}}
{{end}}
