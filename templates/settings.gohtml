{{define "settings"}}
  <div class="narrow">
    <header class="page-title">
      <div class="eyebrow">Settings</div>
      <h1>Your library</h1>
    </header>

    <div class="tabs" role="tablist">
      <button class="tab-button active" type="button" data-tab="profile" role="tab">Profile</button>
      <button class="tab-button" type="button" data-tab="account" role="tab">Account</button>
      <button class="tab-button" type="button" data-tab="import" role="tab">Import</button>
      <button class="tab-button" type="button" data-tab="scrobble" role="tab">Scrobbling</button>
    </div>

    <div class="tab-panel active" id="profile">
      <div class="card">
        <h2>Profile picture</h2>
        <p>JPEG, PNG, GIF or WebP, up to 5MB. Square images look best.</p>
        {{if .PfpError}}<div class="login-error" style="margin-bottom: 14px">{{.PfpError}}</div>{{end}}
        <form method="POST" action="/settings/update-pfp" enctype="multipart/form-data">
          <div class="pfp-edit">
            <div class="hero-art round pfp-preview">
              <img id="pfpPreview" src="{{.Pfp}}" alt="Your profile picture">
            </div>
            <div class="pfp-fields">
              <input type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp" required data-crop="cropper">
              <div class="row">
                <button type="submit" class="no-js-only">Save picture</button>
                <button type="submit" formaction="/settings/update-pfp?remove=1" formnovalidate>Use default</button>
              </div>
            </div>
          </div>
        </form>
      </div>

      {{/* move-and-crop step shown after picking an image (JS); uploads a 512px square */}}
      <div class="modal-overlay" id="cropper" hidden>
        <div class="modal-content crop-dialog" role="dialog" aria-modal="true" aria-labelledby="cropTitle">
          <h2 id="cropTitle">Move and crop</h2>
          <div class="crop-stage" id="cropStage" tabindex="0" aria-label="Drag or use arrow keys to move, plus and minus to zoom">
            <img id="cropImage" alt="" draggable="false">
            <div class="crop-mask" aria-hidden="true"></div>
          </div>
          <label class="crop-zoom">
            <span aria-hidden="true">−</span>
            <input type="range" id="cropZoom" min="1" max="5" step="0.01" value="1" aria-label="Zoom">
            <span aria-hidden="true">+</span>
          </label>
          <p class="modal-hint" id="cropError" role="alert"></p>
          <div class="modal-buttons">
            <button type="button" id="cropCancel" style="margin-left: auto">Cancel</button>
            <button type="button" class="btn-primary" id="cropSave">Save picture</button>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Visibility</h2>
        <p>Public profiles can be viewed by anyone with the link and found in search. Private profiles are only visible to you.</p>
        <form method="POST" action="/settings/update-visibility">
          <label class="switch-row">
            <input type="checkbox" name="public_profile" {{if .PublicProfile}}checked{{end}} onchange="this.form.submit()">
            <span>Share my profile publicly</span>
          </label>
          <noscript><div><button type="submit">Save</button></div></noscript>
          {{if .PublicProfile}}<p class="note" style="margin: 0">Your profile: <a class="ok" href="{{.ProfileURL}}">{{.ProfileURL}}</a></p>{{end}}
        </form>
      </div>

      <div class="card">
        <h2>Timezone</h2>
        <p>Days in your history, heatmap, listening clock and streaks follow this timezone.</p>
        {{if .TimezoneError}}<div class="login-error" style="margin-bottom: 14px">{{.TimezoneError}}</div>{{end}}
        <form method="POST" action="/settings/update-timezone">
          <label>Timezone
            <input type="text" name="timezone" value="{{.Timezone}}" list="timezones" placeholder="Server default"
              autocomplete="off" spellcheck="false" id="timezoneInput">
          </label>
          <datalist id="timezones"></datalist>
          <div class="row">
            <button type="submit">Save timezone</button>
            <button type="button" id="detectTimezone" hidden>Use this device's timezone</button>
          </div>
          <p class="note" style="margin: 0">Leave it empty to use the server's timezone.</p>
        </form>
      </div>

      <div class="card">
        <h2>Bio</h2>
        <p>A line or two about your taste. Shown under your name on your profile; leave it empty to hide it.</p>
        <form method="POST" action="/settings/update-bio">
          <textarea name="bio" maxlength="{{.BioMaxLength}}" placeholder="Currently stuck on…" aria-label="Bio">{{.Bio}}</textarea>
          <div><button type="submit">Save bio</button></div>
        </form>
      </div>
    </div>

    <div class="tab-panel" id="account">
      {{if .AccountError}}<div class="login-error" style="margin-top: 16px">{{.AccountError}}</div>{{end}}
      {{if .AccountOK}}<div class="message success">{{.AccountOK}}</div>{{end}}

      <div class="card">
        <h2>Password</h2>
        <p>Changing it logs you out everywhere else.</p>
        <form method="POST" action="/settings/change-password">
          <label>Current password <input type="password" name="current_password" autocomplete="current-password" required></label>
          <label>New password <input type="password" name="new_password" autocomplete="new-password" minlength="8" maxlength="64" required></label>
          <label>Confirm new password <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" maxlength="64" required></label>
          <div><button type="submit">Change password</button></div>
        </form>
      </div>

      <div class="card danger">
        <h2>Delete account</h2>
        <p>Permanently deletes your account and all of its listening history, artists, albums and settings. This can't be undone.</p>
        <form method="POST" action="/settings/delete-account">
          <label><span>Type <b>{{.LoggedInUsername}}</b> to confirm</span> <input type="text" name="confirm_username" autocomplete="off" spellcheck="false" required></label>
          <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
          <div><button type="submit" class="btn-danger-solid">Delete my account</button></div>
        </form>
      </div>
    </div>

    <div class="tab-panel" id="import">
      <div class="card">
        <h2>Last.fm</h2>
        <p>Bring in your scrobble history. Running it again only adds plays that are missing.</p>
        <form id="lastfm-form" method="POST" action="/settings/import/lastfm">
          <div class="row">
            <input type="text" name="lastfm_username" placeholder="Last.fm username" required style="flex: 1 1 180px">
            <input type="text" name="lastfm_api_key" placeholder="Last.fm API key" required style="flex: 2 1 240px">
          </div>
          <div><button type="submit">Import from Last.fm</button></div>
        </form>
        {{template "progress" "lastfm"}}
      </div>

      <div class="card">
        <h2>Spotify</h2>
        <p>Upload the JSON files from your Spotify data export (up to 30 at a time).</p>
        <form id="spotify-form" method="POST" action="/settings/import/spotify" enctype="multipart/form-data">
          <input type="file" name="json_files" accept=".json,application/json" multiple required>
          <div><button type="submit">Upload Spotify data</button></div>
        </form>
        {{template "progress" "spotify"}}
      </div>

      <div class="card">
        <h2>Apple Music</h2>
        <p>Request your data at <a class="ok" href="https://privacy.apple.com" target="_blank" rel="noopener">privacy.apple.com</a> (choose <b>Apple Media Services information</b>), then upload the zip files Apple sends you. Extracted Apple Music Activity files work too.</p>
        <form id="apple-form" method="POST" action="/import/apple" enctype="multipart/form-data">
          <input type="file" name="apple_files" accept=".zip,.csv,.json" multiple required>
          <div><button type="submit">Import from Apple Music</button></div>
        </form>
        <p class="note" id="apple-status" role="status" style="margin: 12px 0 0"></p>
        <p class="note" style="margin: 8px 0 0">Plays count like on Last.fm: at least half the song or four minutes. Plays muzi already has are skipped.</p>
      </div>
    </div>

    <div class="tab-panel" id="scrobble">
      <div class="card">
        <h2>API key</h2>
        <p>Scrobbling apps authenticate with these.</p>
        {{if .APIKey}}
        <dl class="kv">
          <dt>API key</dt><dd><code>{{.APIKey}}</code></dd>
          <dt>API secret</dt><dd><code>{{.APISecret}}</code></dd>
        </dl>
        {{end}}
        <form method="POST" action="/settings/generate-apikey">
          <div><button type="submit">{{if .APIKey}}Regenerate{{else}}Generate{{end}} API key</button></div>
        </form>
      </div>

      <div class="card">
        <h2>Endpoints</h2>
        <p>Point your scrobbler at one of these paths on this server.</p>
        <dl class="kv">
          <dt>Last.fm compatible</dt><dd><code>/2.0/</code></dd>
          <dt>ListenBrainz</dt><dd><code>/1/submit-listens</code></dd>
        </dl>
      </div>

      <div class="card">
        <h2>Spotify</h2>
        <p>Create an app at <a class="ok" href="https://developer.spotify.com/dashboard" target="_blank" rel="noopener">developer.spotify.com</a>, add this redirect URI to it, then save its credentials here.</p>
        <dl class="kv">
          <dt>Redirect URI</dt><dd><code>{{.SpotifyRedirectURI}}</code></dd>
        </dl>
        <form method="POST" action="/settings/update-spotify">
          <div class="row">
            <input type="text" name="spotify_client_id" placeholder="Client ID" value="{{.SpotifyClientId}}" style="flex: 1 1 200px">
            <input type="password" name="spotify_client_secret" placeholder="Client secret" style="flex: 1 1 200px">
          </div>
          <div class="row">
            <button type="submit">Save credentials</button>
            {{if and .SpotifyClientId (not .SpotifyConnected)}}
            <a class="btn" href="/settings/spotify-connect">Connect Spotify</a>
            {{end}}
          </div>
        </form>
        {{if .SpotifyConnected}}
        <p class="ok" style="margin: 14px 0 0">● Connected — your Spotify plays are being scrobbled.</p>
        {{end}}
        <p class="note" style="margin: 14px 0 0">Credentials alone are enough for artist and album images. Connecting is only needed to scrobble your Spotify playback.</p>
      </div>
    </div>
  </div>

  <script src="/files/import.js" defer></script>
{{end}}

{{define "progress"}}
<div id="{{.}}-progress" class="progress-container" style="display: none;">
  <div class="progress-status" id="{{.}}-progress-status">Initializing…</div>
  <div class="progress-bar-wrapper">
    <div class="progress-bar-fill" id="{{.}}-progress-fill"></div>
    <div class="progress-text" id="{{.}}-progress-text">0%</div>
  </div>
  <div class="progress-tracks" id="{{.}}-progress-tracks"></div>
  <div class="progress-error" id="{{.}}-progress-error"></div>
  <div class="progress-success" id="{{.}}-progress-success"></div>
</div>
{{end}}
