{{define "album"}}
  {{$owner := eq .LoggedInUsername .Username}}
  <section class="hero">
    {{if .Album.CoverUrl}}<img class="hero-backdrop" src="{{.Album.CoverUrl}}" alt="" aria-hidden="true">{{end}}
    {{template "hero-art" (dict "url" .Album.CoverUrl "name" .Album.Title "vt" (artName "album" .Album.Id)
      "edit" $owner "entity" "album" "id" .Album.Id "field" "cover_url")}}
    <div class="hero-text">
      <div class="eyebrow">Album</div>
      <h1>{{.Album.Title}}</h1>
      {{if .ArtistNames}}
      <div class="hero-sub">
        <span>by {{range $i, $name := .ArtistNames}}{{if $i}}, {{end}}<a href="/profile/{{$.Username}}/artist/{{urlquery $name}}">{{$name}}</a>{{end}}</span>
      </div>
      {{end}}
      <div class="stats">
        <div class="stat"><b>{{formatInt .ListenCount}}</b><span>Listens</span></div>
      </div>
      {{if $owner}}
      <div class="hero-actions">
        <button class="btn btn-small" type="button" onclick="openEditModal()">Edit</button>
      </div>
      {{end}}
    </div>
  </section>

  <section class="block" id="plays">
    <header class="block-head"><h2>Plays</h2></header>
    {{template "feed" (dict "entries" .Times "username" .Username "cover" .Album.CoverUrl)}}
    <nav class="pager">
      {{if gt .Page 1}}<a class="btn btn-small" href="/profile/{{.Username}}/album/{{urlquery .Artist.Name}}/{{urlquery .Album.Title}}?page={{sub .Page 1}}#plays">← Newer</a>{{end}}
      {{if .Times}}<a class="btn btn-small" href="/profile/{{.Username}}/album/{{urlquery .Artist.Name}}/{{urlquery .Album.Title}}?page={{add .Page 1}}#plays">Older →</a>{{end}}
    </nav>
  </section>

  {{if $owner}}
  <div id="editModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <h2>Edit album</h2>
      <form id="editForm" data-entity="album" data-id="{{.Album.Id}}">
        <label>Title <input type="text" name="title" value="{{.Album.Title}}"></label>
        <label>Spotify ID <input type="text" name="spotify_id" value="{{.Album.SpotifyId}}"></label>
        <label>MusicBrainz ID <input type="text" name="musicbrainz_id" value="{{.Album.MusicbrainzId}}"></label>
        <p class="modal-hint">Click the cover to upload your own image.</p>
        <div class="modal-buttons">
          <button type="button" class="reset-image-btn" onclick="resetImage('album', {{.Album.Id}}, 'cover_url')">Use automatic image</button>
          <button type="button" onclick="closeEditModal()">Cancel</button>
          <button type="submit">Save</button>
        </div>
      </form>
    </div>
  </div>
  {{end}}
{{end}}
