<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d0e0c">
    <title>Import · muzi</title>
    {{template "head-common"}}
  </head>
  <body>
    <main class="narrow" style="margin: 0 auto; padding: 0 var(--gutter) 80px">
      <header class="page-title">
        <div class="eyebrow">Welcome, {{.Username}}</div>
        <h1>Bring your history</h1>
        <p>Import past listens now, or later from <a class="ok" href="/settings">settings</a>.</p>
      </header>
      <div class="card">
        <h2>Last.fm</h2>
        <p>Import your Last.fm scrobbles.</p>
        <form id="lastfm-form" method="POST" action="/import/lastfm">
          <div class="row">
            <input type="text" name="lastfm_username" placeholder="Last.fm username" required style="flex: 1 1 180px">
            <input type="text" name="lastfm_api_key" placeholder="Last.fm API key" required style="flex: 2 1 240px">
          </div>
          <div><button type="submit">Import from Last.fm</button></div>
        </form>
        {{template "progress" "lastfm"}}
      </div>
      <div class="card">
        <h2>Spotify</h2>
        <p>Upload the JSON files from your Spotify data export.</p>
        <form id="spotify-form" method="POST" action="/import/spotify" enctype="multipart/form-data">
          <input type="file" name="json_files" accept=".json,application/json" multiple required>
          <div><button type="submit">Upload Spotify data</button></div>
        </form>
        {{template "progress" "spotify"}}
      </div>
    </main>
    <script src="/files/import.js"></script>
  </body>
</html>
