{{define "profile"}}
  <section class="hero">
    {{/* the profile glows with the colors of your #1 artist */}}
    {{range $i, $a := .TopArtists}}{{if and (eq $i 0) $a.Artist.ImageUrl}}
    <img class="hero-backdrop" src="{{$a.Artist.ImageUrl}}" alt="" aria-hidden="true">
    {{end}}{{end}}
    <div class="hero-art round">
      <img src="{{.Pfp}}" alt="{{.Username}}'s avatar" decoding="async">
    </div>
    <div class="hero-text">
      <div class="eyebrow">Listening diary</div>
      <h1>{{.Username}}</h1>
      {{if .Bio}}<div class="hero-sub hero-bio">{{.Bio}}</div>{{end}}
      <div class="stats">
        <div class="stat"><b>{{formatInt .ScrobbleCount}}</b><span>Listens</span></div>
        <div class="stat"><b>{{formatInt .TrackCount}}</b><span>Tracks</span></div>
        <div class="stat"><b>{{formatInt .ArtistCount}}</b><span>Artists</span></div>
      </div>
    </div>
  </section>

  {{with .Rhythm}}
  <section class="block" id="rhythm">
    <header class="block-head">
      <h2>Rhythm <em>· the past year</em></h2>
    </header>
    <div class="rhythm">
      <div>
        <div class="heatmap-scroll" data-scroll-end>
          <div class="heatmap" role="img" aria-label="Plays per day over the past year">
            {{range .Weeks}}
            <div class="hw">
              {{if .MonthLabel}}<span class="hw-label">{{.MonthLabel}}</span>{{end}}
              {{range .Days}}<i class="hc l{{.Level}}{{if .Future}} future{{end}}"{{if not .Future}} title="{{formatInt .Count}} plays · {{.Date.Format "Mon, Jan 2 2006"}}"{{end}}></i>{{end}}
            </div>
            {{end}}
          </div>
        </div>
        <div class="heat-legend" aria-hidden="true">
          <span>less</span><i class="hc"></i><i class="hc l1"></i><i class="hc l2"></i><i class="hc l3"></i><i class="hc l4"></i><span>more</span>
        </div>
        <div class="rhythm-stats">
          <div class="stat"><b>{{formatInt .YearTotal}}</b><span>Plays</span></div>
          <div class="stat"><b>{{.ActiveDays}}</b><span>Active days</span></div>
          <div class="stat"><b>{{.CurrentStreak}}</b><span>Day streak</span></div>
          <div class="stat"><b>{{.LongestStreak}}</b><span>Longest streak</span></div>
          {{if .BusiestCount}}
          <div class="stat" title="{{.BusiestDay.Format "Monday, January 2 2006"}}"><b>{{formatInt .BusiestCount}}</b><span>Busiest · {{.BusiestDay.Format "Jan 2"}}</span></div>
          {{end}}
        </div>
      </div>
      <svg class="clock" viewBox="0 0 200 200" role="img" aria-label="Plays by hour of day{{if .PeakHour}}, peaking at {{.PeakHour}}{{end}}">
        <circle class="ring" cx="100" cy="100" r="30"/>
        <circle class="ring" cx="100" cy="100" r="88" stroke-dasharray="1 4"/>
        {{range .Clock}}
        <line x1="{{.X1}}" y1="{{.Y1}}" x2="{{.X2}}" y2="{{.Y2}}"{{if .Peak}} class="peak"{{end}}><title>{{hourLabel .Hour}} · {{formatInt .Count}} plays</title></line>
        {{end}}
        <text x="100" y="5">12a</text>
        <text x="195" y="100">6a</text>
        <text x="100" y="196">12p</text>
        <text x="5" y="100">6p</text>
        {{if .PeakHour}}
        <text class="clock-peak" x="100" y="97">{{.PeakHour}}</text>
        <text class="clock-caption" x="100" y="113">PEAK</text>
        {{end}}
      </svg>
    </div>
  </section>
  {{end}}

  <section class="block" id="artists">
    <header class="block-head">
      <h2>Top artists</h2>
      {{template "chart-controls" (dict "q" .RawQuery "prefix" "" "period" .TopArtistsPeriod "view" .TopArtistsView "limit" .TopArtistsLimit "anchor" "artists" "views" true)}}
    </header>
    {{if .TopArtists}}
      {{$max := (index .TopArtists 0).ListenCount}}
      {{if eq .TopArtistsView "grid"}}
      <div class="mosaic">
        {{range $i, $a := .TopArtists}}
        <a class="tile" href="/profile/{{$.Username}}/artist/{{urlquery $a.Artist.Name}}">
          <div class="tile-art" style="view-transition-name: {{artName "artist" $a.Artist.Id}}">{{template "art" (dict "url" $a.Artist.ImageUrl "name" $a.Artist.Name)}}</div>
          <span class="tile-rank">{{rank $i}}</span>
          <span class="tile-meta">
            <span class="tile-name">{{$a.Artist.Name}}</span>
            <span class="tile-sub">{{formatInt $a.ListenCount}} plays</span>
          </span>
        </a>
        {{end}}
      </div>
      {{else}}
      <ol class="chart">
        {{range $i, $a := .TopArtists}}
        <li>
          <a class="chart-row" style="--pct: {{pct $a.ListenCount $max}}%" href="/profile/{{$.Username}}/artist/{{urlquery $a.Artist.Name}}">
            <span class="chart-rank">{{add $i 1}}</span>
            <span class="thumb round" style="view-transition-name: {{artName "artist" $a.Artist.Id}}">{{template "art" (dict "url" $a.Artist.ImageUrl "name" $a.Artist.Name)}}</span>
            <span class="chart-text"><span class="chart-name">{{$a.Artist.Name}}</span></span>
            <span class="count">{{formatInt $a.ListenCount}}</span>
          </a>
        </li>
        {{end}}
      </ol>
      {{end}}
    {{else}}
    <p class="empty">No plays in this period.</p>
    {{end}}
  </section>

  <section class="block" id="albums">
    <header class="block-head">
      <h2>Top albums</h2>
      {{template "chart-controls" (dict "q" .RawQuery "prefix" "album_" "period" .TopAlbumsPeriod "view" .TopAlbumsView "limit" .TopAlbumsLimit "anchor" "albums" "views" true)}}
    </header>
    {{if .TopAlbums}}
      {{$max := (index .TopAlbums 0).ListenCount}}
      {{if eq .TopAlbumsView "grid"}}
      <div class="mosaic">
        {{range $i, $a := .TopAlbums}}
        <a class="tile" href="/profile/{{$.Username}}/album/{{urlquery $a.Artist}}/{{urlquery $a.AlbumName}}">
          <div class="tile-art" style="view-transition-name: {{artName "album" $a.Id}}">{{template "art" (dict "url" $a.CoverUrl "name" $a.AlbumName)}}</div>
          <span class="tile-rank">{{rank $i}}</span>
          <span class="tile-meta">
            <span class="tile-name">{{$a.AlbumName}}</span>
            <span class="tile-sub">{{$a.Artist}} · {{formatInt $a.ListenCount}} plays</span>
          </span>
        </a>
        {{end}}
      </div>
      {{else}}
      <ol class="chart">
        {{range $i, $a := .TopAlbums}}
        <li>
          <a class="chart-row" style="--pct: {{pct $a.ListenCount $max}}%" href="/profile/{{$.Username}}/album/{{urlquery $a.Artist}}/{{urlquery $a.AlbumName}}">
            <span class="chart-rank">{{add $i 1}}</span>
            <span class="thumb" style="view-transition-name: {{artName "album" $a.Id}}">{{template "art" (dict "url" $a.CoverUrl "name" $a.AlbumName)}}</span>
            <span class="chart-text"><span class="chart-name">{{$a.AlbumName}}</span><span class="chart-sub">{{$a.Artist}}</span></span>
            <span class="count">{{formatInt $a.ListenCount}}</span>
          </a>
        </li>
        {{end}}
      </ol>
      {{end}}
    {{else}}
    <p class="empty">No plays in this period.</p>
    {{end}}
  </section>

  <div class="two-col">
    <section class="block" id="tracks">
      <header class="block-head">
        <h2>Top tracks</h2>
        {{template "chart-controls" (dict "q" .RawQuery "prefix" "track_" "period" .TopTracksPeriod "view" "list" "limit" .TopTracksLimit "anchor" "tracks" "views" false)}}
      </header>
      {{if .TopTracks}}
      {{$max := (index .TopTracks 0).ListenCount}}
      <ol class="chart">
        {{range $i, $t := .TopTracks}}
        <li>
          <a class="chart-row" style="--pct: {{pct $t.ListenCount $max}}%" href="/profile/{{$.Username}}/song/{{urlquery $t.Artist}}/{{urlquery $t.SongName}}">
            <span class="chart-rank">{{add $i 1}}</span>
            <span class="thumb">{{template "art" (dict "url" $t.CoverUrl "name" $t.SongName)}}</span>
            <span class="chart-text"><span class="chart-name">{{$t.SongName}}</span><span class="chart-sub">{{$t.Artist}}</span></span>
            <span class="count">{{formatInt $t.ListenCount}}</span>
          </a>
        </li>
        {{end}}
      </ol>
      {{else}}
      <p class="empty">No plays in this period.</p>
      {{end}}
    </section>

    <section class="block" id="recent">
      {{$owner := eq .LoggedInUsername .Username}}
      <header class="block-head">
        <h2>{{if gt .Page 1}}Earlier plays{{else}}Recently played{{end}}</h2>
        {{if $owner}}<button class="btn btn-small" type="button" data-select-toggle>Select</button>{{end}}
      </header>
      {{template "feed" (dict "entries" .History "username" .Username "nowTitle" .NowPlayingTitle "nowArtist" .NowPlayingArtist "select" $owner)}}
      <nav class="pager">
        {{if gt .Page 1}}<a class="btn btn-small" href="/profile/{{.Username}}?page={{sub .Page 1}}#recent">← Newer</a>{{end}}
        {{if .History}}<a class="btn btn-small" href="/profile/{{.Username}}?page={{add .Page 1}}#recent">Older →</a>{{end}}
      </nav>
    </section>
  </div>
{{end}}
